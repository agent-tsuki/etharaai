# ── Local Docker ──────────────────────────────────────────────────────────────
POSTGRES_DB=inventory_db
POSTGRES_USER=inventory_user
POSTGRES_PASSWORD=change_me_in_production

DATABASE_URL=postgresql://inventory_user:change_me_in_production@db:5432/inventory_db
ALLOWED_ORIGINS=["http://localhost:3000","http://localhost:8000"]
LOG_LEVEL=INFO

# ── Frontend ──────────────────────────────────────────────────────────────────
# Vercel: set VITE_API_URL to your Railway backend URL in the Vercel dashboard.
# Local Docker: leave empty — Vite proxies /api to the backend container.
VITE_API_URL=

# ── Railway (backend service env vars) ────────────────────────────────────────
# DATABASE_URL   → auto-provided by Railway PostgreSQL add-on
# PORT           → auto-provided by Railway
# ALLOWED_ORIGINS → set to your Vercel deployment URL, e.g.:
#   ALLOWED_ORIGINS=["https://your-app.vercel.app"]
# LOG_LEVEL=INFO

# JWT Auth (generate a strong random key for production)
SECRET_KEY=change-me-to-a-long-random-secret-key-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7
RESET_TOKEN_EXPIRE_MINUTES=30
